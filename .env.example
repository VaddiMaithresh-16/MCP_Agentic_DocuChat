# Required by the upgraded Gradio backend
GEMINI_API_KEY=your_gemini_api_key

# Optional for web search (and any other MCP tools) in the upgraded backend.
# The original main.py flow expects these values.
COMPOSIO_API_KEY=your_composio_api_key
COMPOSIO_USER_ID=your_composio_user_id
# Comma-separated Composio toolkits to load for the Gemini agent. Add more
# (e.g. GOOGLECALENDAR, GMAIL, NOTION — whatever your Composio account has
# connected) without touching code.
COMPOSIO_TOOLKITS=TAVILY

EMBEDDING_PROVIDER=local
# local: HuggingFace sentence-transformer, runs on this machine, no API calls.
EMBEDDING_MODEL=BAAI/bge-base-en-v1.5
# online: Google's embedding API — no local model download, needs GEMINI_API_KEY.
# Switch EMBEDDING_PROVIDER=online to use this instead.
EMBEDDING_MODEL_ONLINE=models/text-embedding-004
HF_TOKEN=your_huggingface_token

GEMINI_MODEL=gemini-3.1-flash-lite

# Ollama settings. Ollama is expected to be running locally.
OLLAMA_MODEL=gemma3:4b
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_KEEP_ALIVE=10m
OLLAMA_NUM_CTX=4096
ANSWER_LOOP_MAX_ATTEMPTS=2

# llama.cpp settings. Run `llama-server` locally first, e.g.:
#   llama-server -hf Qwen/Qwen3-4B-GGUF:Q4_0 --port 8080 -ngl 99 -c 4096
# -ngl 99 offloads all layers to GPU if you have one (drop it for CPU-only).
# -c sets the context window llama-server itself uses.
# This exposes an OpenAI-compatible API that the app talks to directly.
LLAMACPP_MODEL=Qwen3-4B-GGUF:Q4_0
LLAMACPP_BASE_URL=http://localhost:8080/v1
LLAMACPP_API_KEY=not-needed
LLAMACPP_NUM_CTX=4096
LLAMACPP_STATUS_CACHE_SECONDS=15

# Response cache (SQLite-backed, keyed on question + document + memory).
# Bounded so it can't grow forever: entries older than the TTL are treated
# as misses, and the table is pruned back to the max size on every write.
CACHE_TTL_SECONDS=604800
CACHE_MAX_ENTRIES=2000

# Minimum seconds between two questions from the same user_id — a basic
# guard against accidental double-submits or spam-clicking "Ask" while a
# local model is still generating.
RATE_LIMIT_SECONDS=1.5

# Log verbosity: DEBUG, INFO, WARNING, ERROR.
LOG_LEVEL=INFO

DOCUMENT_PATH=./data/research_paper.pdf

MEMORY_DATABASE=./agentic_rag_memory.sqlite3
CHROMA_DIR=./chroma_langchain_db
CHROMA_COLLECTION=agentic_rag_research_collection
CHUNK_SIZE=700
CHUNK_OVERLAP=100

# Retrieval tuning (MMR search) — used once per question and reused for
# both the generation context and the sources shown in the UI.
RETRIEVAL_K=4
RETRIEVAL_FETCH_K=12

# How long to trust a cached Ollama/GPU health check before re-probing.
# Keeps the per-message hot path from re-running nvidia-smi + an HTTP
# health check on every single question.
OLLAMA_STATUS_CACHE_SECONDS=15

# Gradio sharing and login. Keep sharing disabled for private documents.
GRADIO_SHARE=false
GRADIO_USERNAME=choose_a_username
GRADIO_PASSWORD=choose_a_strong_password
